{
  "manifest_version": 3,
  "name": "SPT Tahunan Scraper",
  "version": "1.3",
  "description": "Scraping tabel di section SPT Tahunan secara otomatis di dalam CORETAX. Last Update : Add checker for the table (Deployment version), Last Update : 03-02-26",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SPT Tahunan Scraper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["xlsx.full.min.js", "content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["xlsx.full.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}